.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: var(--color-bg-page);
}

/* ---------- 顶部搜索条 ---------- */
.header {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  background-color: var(--color-bg-card);
}

.header-search {
  flex: 1;
  min-width: 0;
}

.cancel {
  flex-shrink: 0;
  margin-left: 24rpx;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: var(--color-text-secondary);
  white-space: nowrap;
}

.cancel:active {
  opacity: 0.7;
}

.scroll {
  flex: 1;
  min-height: 0;
  height: 0;
}

/* ---------- 标签区 ---------- */
.tag-section {
  margin: 24rpx 32rpx 0;
  padding: 32rpx;
  background-color: var(--color-bg-card);
  border-radius: 16rpx;
  box-shadow: var(--shadow-card);
}

.section-head {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.clear-history {
  margin-left: auto;
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}

.clear-history:active {
  opacity: 0.7;
}

.tag-wrap {
  display: flex;
  flex-wrap: wrap;
}

.tag {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 60rpx;
  padding: 0 24rpx;
  margin: 0 16rpx 16rpx 0;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  background-color: var(--color-bg-page);
  border-radius: 48rpx;
}

.tag:active {
  opacity: 0.75;
}

.tag-primary {
  color: var(--color-primary);
  background-color: var(--color-tag-bg);
}

/* ---------- 结果列表 ---------- */
.result-head {
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx 0;
}

.result-title {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.result-count {
  margin-left: 16rpx;
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}

.list {
  padding: 24rpx 32rpx 0;
}

.list-item {
  margin-bottom: 24rpx;
}

.footer {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 0 48rpx;
}

.footer-text {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}

.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
}

.loading-text {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}