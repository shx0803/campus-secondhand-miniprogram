.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: var(--color-bg-page);
}

.scroll {
  flex: 1;
  min-height: 0;
  height: 0;
}

.section {
  margin: 24rpx 32rpx 0;
  padding: 32rpx;
  background-color: var(--color-bg-card);
  border-radius: 16rpx;
  box-shadow: var(--shadow-card);
}

.section-title {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
  margin-bottom: 24rpx;
}

.required {
  color: #f53f3f;
  margin-left: 4rpx;
}

/* ---------- 图片上传 ---------- */
.image-grid {
  display: flex;
  flex-wrap: wrap;
}

.image-item {
  position: relative;
  width: 190rpx;
  height: 190rpx;
  margin: 0 16rpx 16rpx 0;
  border-radius: 12rpx;
  overflow: hidden;
  background-color: var(--color-bg-hover);
}

.image {
  width: 100%;
  height: 100%;
  display: block;
}

.image-delete {
  display: flex;
  align-items: center;
  justify-content: center;
  position: absolute;
  right: 0;
  top: 0;
  width: 44rpx;
  height: 44rpx;
  background-color: rgba(0, 0, 0, 0.55);
  border-bottom-left-radius: 12rpx;
}

.image-delete-text {
  font-size: 24rpx;
  color: #ffffff;
  line-height: 1;
}

.image-add {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-direction: column;
  width: 190rpx;
  height: 190rpx;
  margin: 0 16rpx 16rpx 0;
  border-radius: 12rpx;
  border: 2rpx dashed var(--color-border);
  background-color: #fff6f1;
}

.image-add:active {
  opacity: 0.75;
}

.image-add-icon {
  font-size: 52rpx;
  color: var(--color-primary);
  line-height: 1;
}

.image-add-text {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}

.tip {
  display: block;
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  margin-top: 8rpx;
}

/* ---------- 表单字段 ---------- */
.field-row {
  display: flex;
  align-items: center;
  min-height: 96rpx;
  border-bottom: 1rpx solid var(--color-divider);
}

.field-row:last-child {
  border-bottom: none;
}

.label {
  flex-shrink: 0;
  width: 140rpx;
  font-size: 28rpx;
  color: var(--color-text-primary);
}

.input {
  flex: 1;
  min-width: 0;
  height: 96rpx;
  font-size: 28rpx;
  color: var(--color-text-primary);
}

.input-placeholder {
  color: var(--color-text-disabled);
  font-size: 28rpx;
}

.price-wrap {
  flex: 1;
  display: flex;
  align-items: center;
  min-width: 0;
}

.price-symbol {
  flex-shrink: 0;
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-price);
}

.counter {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}

.textarea {
  width: 100%;
  height: 220rpx;
  margin-top: 16rpx;
  padding: 24rpx;
  font-size: 28rpx;
  color: var(--color-text-primary);
  background-color: var(--color-bg-page);
  border-radius: 12rpx;
  box-sizing: border-box;
}

.textarea-placeholder {
  color: var(--color-text-disabled);
  font-size: 28rpx;
}

.textarea-footer {
  display: flex;
  justify-content: flex-end;
  margin-top: 8rpx;
}

/* ---------- 标签选择 ---------- */
.tag-wrap {
  display: flex;
  flex-wrap: wrap;
}

.tag {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 60rpx;
  padding: 0 24rpx;
  margin: 0 16rpx 16rpx 0;
  font-size: 24rpx;
  color: var(--color-text-secondary);
  background-color: var(--color-bg-page);
  border-radius: 48rpx;
  border: 1rpx solid transparent;
}

.tag:active {
  opacity: 0.8;
}

.tag-active {
  color: var(--color-primary);
  background-color: var(--color-tag-bg);
  border-color: var(--color-primary);
  font-weight: 500;
}

/* ---------- 底部留白 ---------- */
.spacer {
  height: 48rpx;
}

/* ---------- 底部提交栏 ---------- */
.footer {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background-color: var(--color-bg-card);
  box-shadow: var(--shadow-float);
}

.reset-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  min-width: 160rpx;
  height: 96rpx;
  margin-right: 24rpx;
  padding: 0 32rpx;
  border: 1rpx solid var(--color-border);
  border-radius: 48rpx;
  background-color: var(--color-bg-card);
}

.reset-btn:active {
  opacity: 0.8;
}

.reset-text {
  font-size: 28rpx;
  color: var(--color-text-secondary);
  white-space: nowrap;
}

.submit-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  flex: 1;
  height: 96rpx;
  background: var(--gradient-primary);
  border-radius: 48rpx;
}

.submit-btn:active {
  opacity: 0.9;
  transform: scale(0.99);
}

.submit-btn-disabled {
  opacity: 0.5;
}

.submit-text {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-white);
  white-space: nowrap;
}