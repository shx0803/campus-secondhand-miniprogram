.page {
  display: flex;
  flex-direction: row;
  height: 100vh;
  background-color: var(--color-bg-page);
}

/* ---------- 左侧分类导航 ---------- */
.sidebar {
  flex-shrink: 0;
  width: 180rpx;
  height: 100%;
  background-color: var(--color-bg-page);
}

.side-item {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 108rpx;
  font-size: 24rpx;
  color: var(--color-text-secondary);
}

.side-item:active {
  opacity: 0.75;
}

.side-item-active {
  background-color: var(--color-bg-card);
  color: var(--color-primary);
  font-weight: 600;
}

.side-item-active::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 8rpx;
  height: 40rpx;
  background: var(--gradient-primary);
  border-top-right-radius: 4rpx;
  border-bottom-right-radius: 4rpx;
}

/* ---------- 右侧内容区 ---------- */
.content {
  flex: 1;
  min-width: 0;
  height: 100%;
  background-color: var(--color-bg-card);
}

.scroll {
  height: 100%;
}

.banner {
  display: flex;
  flex-direction: column;
  margin: 24rpx 24rpx 0;
  padding: 32rpx;
  border-radius: 16rpx;
  background: var(--gradient-primary);
}

.banner-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--color-text-white);
}

.banner-desc {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
}

.grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
  padding: 24rpx;
}

.grid-item {
  width: 252rpx;
  margin-bottom: 24rpx;
}

.load-more {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 0 48rpx;
}

.load-more-text {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}