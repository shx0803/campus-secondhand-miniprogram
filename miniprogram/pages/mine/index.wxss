.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: var(--color-bg-page);
}

/* ---------- 用户信息卡 ---------- */
.profile {
  flex-shrink: 0;
  padding: 48rpx 32rpx 32rpx;
  background: var(--gradient-primary);
}

.profile-top {
  display: flex;
  align-items: center;
}

.avatar {
  flex-shrink: 0;
  width: 128rpx;
  height: 128rpx;
  border-radius: 999rpx;
  border: 4rpx solid rgba(255, 255, 255, 0.6);
  background-color: rgba(255, 255, 255, 0.3);
}

.profile-info {
  flex: 1;
  min-width: 0;
  margin-left: 32rpx;
}

.nickname {
  font-size: 36rpx;
  font-weight: 600;
  color: var(--color-text-white);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-meta {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}

.meta-chip {
  height: 40rpx;
  line-height: 40rpx;
  padding: 0 16rpx;
  margin-right: 16rpx;
  border-radius: 4rpx;
  font-size: 22rpx;
  color: var(--color-text-white);
  background-color: rgba(255, 255, 255, 0.22);
  white-space: nowrap;
}

.signature {
  display: block;
  margin-top: 14rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.9);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

/* ---------- 数据统计 ---------- */
.stats {
  display: flex;
  align-items: center;
  margin-top: 32rpx;
  padding: 24rpx 0;
  border-radius: 16rpx;
  background-color: rgba(255, 255, 255, 0.18);
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.stat-value {
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-text-white);
}

.stat-label {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
}

.stat-divider {
  width: 1rpx;
  height: 48rpx;
  background-color: rgba(255, 255, 255, 0.3);
}

/* ---------- Tab 切换 ---------- */
.tab-bar {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  height: 96rpx;
  padding: 0 32rpx;
  background-color: var(--color-bg-card);
}

.tab-item {
  position: relative;
  display: flex;
  align-items: center;
  height: 96rpx;
  margin-right: 48rpx;
}

.tab-item:active {
  opacity: 0.75;
}

.tab-text {
  font-size: 28rpx;
  color: var(--color-text-secondary);
}

.tab-text-active {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--color-text-primary);
}

.tab-indicator {
  position: absolute;
  left: 50%;
  bottom: 10rpx;
  transform: translateX(-50%);
  width: 48rpx;
  height: 6rpx;
  border-radius: 4rpx;
  background: var(--gradient-primary);
}

/* ---------- 列表 ---------- */
.scroll {
  flex: 1;
  min-height: 0;
  height: 0;
}

.list {
  padding: 24rpx 32rpx 0;
}

.list-item {
  margin-bottom: 24rpx;
}

.tip-bar {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 16rpx 0 48rpx;
}

.tip-text {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}

.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 80rpx 0;
}

.loading-text {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
}

/* ---------- 页脚品牌水印 ---------- */
.brand-footer {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 24rpx 0 48rpx;
}

.brand-footer-text {
  font-size: 22rpx;
  color: var(--color-text-disabled);
  letter-spacing: 1rpx;
}