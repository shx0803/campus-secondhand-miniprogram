.search-bar {
  display: flex;
  align-items: center;
  width: 100%;
  height: 72rpx;
  padding: 0 24rpx;
  border-radius: 48rpx;
  box-sizing: border-box;
}

.theme-light {
  background-color: rgba(255, 255, 255, 0.92);
}

.theme-gray {
  background-color: var(--color-bg-page);
}

.readonly {
  transition: opacity 0.15s ease;
}

.search-bar:active {
  opacity: 0.9;
}

.icon {
  flex-shrink: 0;
  font-size: 28rpx;
  margin-right: 16rpx;
}

.input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  font-size: 28rpx;
  color: var(--color-text-primary);
}

.placeholder {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  color: var(--color-text-tertiary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.placeholder-input {
  font-size: 28rpx;
  color: var(--color-text-tertiary);
}

.clear {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
  margin-left: 8rpx;
  border-radius: 999rpx;
  background-color: rgba(0, 0, 0, 0.06);
}

.clear-text {
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}