.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 32rpx;
}

.icon {
  font-size: 96rpx;
  line-height: 1;
  opacity: 0.85;
}

.text {
  margin-top: 32rpx;
  font-size: 28rpx;
  color: var(--color-text-tertiary);
}

.action {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 48rpx;
  min-width: 240rpx;
  height: 80rpx;
  padding: 0 48rpx;
  background: var(--gradient-primary);
  border-radius: 48rpx;
}

.action:active {
  opacity: 0.9;
  transform: scale(0.98);
}

.action-text {
  font-size: 28rpx;
  font-weight: 500;
  color: var(--color-text-white);
  white-space: nowrap;
}