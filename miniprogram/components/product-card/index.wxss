.card {
  background-color: var(--color-bg-card);
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: var(--shadow-card);
}

.card:active {
  transform: scale(0.98);
  opacity: 0.94;
}

/* ---------- 双列瀑布流卡片 ---------- */
.card-grid {
  width: 100%;
}

.card-grid .image-wrap {
  position: relative;
  width: 100%;
  height: 320rpx;
}

.card-grid .title {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  font-size: 28rpx;
  color: var(--color-text-primary);
  line-height: 1.3;
  min-height: 74rpx;
}

/* ---------- 单列横向卡片 ---------- */
.card-list {
  display: flex;
  flex-direction: row;
  width: 100%;
  padding: 24rpx;
}

.card-list .image-wrap {
  flex-shrink: 0;
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  overflow: hidden;
}

.card-list .content {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
  padding: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.card-list .title {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  font-size: 28rpx;
  color: var(--color-text-primary);
  line-height: 1.3;
}

/* ---------- 图片 ---------- */
.image-wrap {
  position: relative;
  background-color: var(--color-bg-hover);
}

/* 卡片名牌水印 */
.watermark {
  position: absolute;
  right: 12rpx;
  bottom: 12rpx;
  height: 34rpx;
  line-height: 34rpx;
  padding: 0 14rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  letter-spacing: 1rpx;
  color: rgba(255, 255, 255, 0.95);
  background-color: rgba(0, 0, 0, 0.28);
}

.image {
  width: 100%;
  height: 100%;
  display: block;
}

.badge-new {
  position: absolute;
  left: 0;
  top: 16rpx;
  padding: 0 16rpx;
  height: 36rpx;
  line-height: 36rpx;
  font-size: 22rpx;
  color: var(--color-text-white);
  background: var(--gradient-primary);
  border-top-right-radius: 4rpx;
  border-bottom-right-radius: 4rpx;
}

/* ---------- 内容 ---------- */
.content {
  padding: 24rpx;
}

.price-row {
  display: flex;
  align-items: baseline;
  margin-top: 16rpx;
}

.price-symbol {
  font-size: 24rpx;
  color: var(--color-price);
  font-weight: 600;
}

.price {
  margin-left: 2rpx;
  font-size: 36rpx;
  font-weight: 700;
  color: var(--color-price);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.original-price {
  margin-left: 16rpx;
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  text-decoration: line-through;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.meta-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}

.seller {
  display: flex;
  align-items: center;
  flex: 1;
  min-width: 0;
}

.avatar {
  width: 36rpx;
  height: 36rpx;
  border-radius: 999rpx;
  background-color: var(--color-bg-hover);
  flex-shrink: 0;
}

.seller-name {
  margin-left: 8rpx;
  font-size: 22rpx;
  color: var(--color-text-tertiary);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.views {
  flex-shrink: 0;
  margin-left: 16rpx;
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}

.tag-row {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}

.tag {
  flex-shrink: 0;
  margin-right: 16rpx;
  padding: 0 16rpx;
  height: 36rpx;
  line-height: 36rpx;
  font-size: 22rpx;
  color: var(--color-tag-text);
  background-color: var(--color-tag-bg);
  border-radius: 4rpx;
  white-space: nowrap;
}

.time {
  margin-left: auto;
  flex-shrink: 0;
  font-size: 22rpx;
  color: var(--color-text-tertiary);
}