<view class="card {{layout === 'list' ? 'card-list' : 'card-grid'}}" bindtap="onTap">
  <view class="image-wrap">
    <image
      class="image"
      src="{{product.images[0]}}"
      mode="aspectFill"
      lazy-load
      binderror="onImageError"
    />
    <view wx:if="{{isNew}}" class="badge-new">全新</view>
    <text class="watermark">邵鹤轩</text>
  </view>

  <view class="content">
    <text class="title">{{product.title}}</text>

    <view class="price-row">
      <text class="price-symbol">¥</text>
      <text class="price">{{priceText}}</text>
      <text wx:if="{{originalPriceText}}" class="original-price">{{originalPriceText}}</text>
    </view>

    <view class="meta-row">
      <view class="seller">
        <image class="avatar" src="{{product.sellerAvatar}}" mode="aspectFill" />
        <text class="seller-name">{{product.sellerName}}</text>
      </view>
      <text class="views">{{viewsText}} 浏览</text>
    </view>

    <view wx:if="{{layout === 'list'}}" class="tag-row">
      <text class="tag">{{product.condition}}</text>
      <text class="tag">{{product.campus}}</text>
      <text class="time">{{timeText}}</text>
    </view>
  </view>
</view>